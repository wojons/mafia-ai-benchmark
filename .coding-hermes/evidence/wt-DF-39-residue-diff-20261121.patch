+function breakdownEntries(
+  breakdown: Record<string, PerformanceBreakdown> | undefined,
+): [string, PerformanceBreakdown][] {
+  return breakdown ? Object.entries(breakdown) : [];
+}
+
+function formatWinRate(winRate: number): string {
+  return `${(winRate * 100).toFixed(1)}%`;
+}
+
+function dominantPlayerCount(
+  breakdown: Record<string, PerformanceBreakdown> | undefined,
+): { playerCount: string; share: number } | undefined {
+  const entries = breakdownEntries(breakdown);
+  const totalGames = entries.reduce((total, [, stats]) => total + stats.gamesPlayed, 0);
+  if (totalGames <= 0) return undefined;
+  const [playerCount, stats] = entries.reduce((current, entry) =>
+    entry[1].gamesPlayed > current[1].gamesPlayed ? entry : current,
+  );
+  return { playerCount, share: stats.gamesPlayed / totalGames };
+}
