# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# packages/shared does NOT emit in-source compiler output (`tsc -b` writes to
# dist/, already ignored above) and it ships AUTHORED .js/.d.ts sources that the
# legacy engine require()s directly. Blanket patterns for those families here
# made 7 tracked files "ignored", so every ignore-aware materialization
# (git init + git add -A snapshots, act checkouts) silently dropped them and the
# server suite failed with "Cannot find module
# './packages/shared/src/agents/response-parser'". QA-MAFIA-AI-BENCHMARK-15-R2:
# do NOT re-add them. The guard test
# packages/shared/src/__tests__/repo/tracked-files-not-ignored.test.ts fails if a
# tracked file under packages/shared/src is ever git-ignored again.

# Environment files (never commit these!)
.env
.env.local
.env.*.local
!.env.example

# Database
data/
*.db
*.sqlite

# Logs
*.log
logs/
npm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Python caches (legacy tooling artifacts)
__pycache__/
.pytest_cache/
.ruff_cache/

# OS files
Thumbs.db
.DS_Store

# Infrastructure / agent tooling
.githooks/
.gitreins/history/
.vfs/
.worktrees/
.axiom/
.hermes/plans/

# Deploy-refresh stamp (DF-MAFIA-AI-BENCHMARK-38): records the HEAD sha of the
# last successful container rebuild; runtime state, never committed.
.deploy-stamp

# Turborepo cache
.turbo/

# OpenCode
.opencode/
.graph-harness/
.gitreins/tasks.yaml

# Stale artifacts
*.bak

