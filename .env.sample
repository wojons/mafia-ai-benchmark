# Mafia AI Benchmark Environment Configuration
# Copy this file to .env and fill in your values
#
# SCOPE NOTES (MAF-GAP-072 audit)
# - Server-process variables (PORT, DB_PATH, NODE_ENV) are read by
#   apps/server/src/index.ts when the API server starts.
# - Engine variables are consumed by the legacy game-engine child process
#   (game-engine.js) spawned by apps/server/src/services/legacy-game-adapter.ts.
#   The bridge (apps/server/src/services/legacy-bridge.js) loads this .env and
#   the adapter forwards the parent environment to the child.
# - Every uncommented entry below has a verified reader in the source tree.
#   The full measured matrix — and the legacy names this audit removed —
#   lives in CONFIG_GUIDE.md.

# =============================================================================
# LLM Provider API Keys
# =============================================================================

# OpenRouter API Key (OpenAI-compatible endpoint - RECOMMENDED)
# Get your key at: https://openrouter.ai/keys
OPENAI_API_KEY=???

# Alternative providers (optional)
# ANTHROPIC_API_KEY=sk-ant...xxxx
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxxxxxx
# GROQ_API_KEY=gsk_xx...xxxx
# META_API_KEY=xxxxxxxxxxxxxxxxxxxx
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxx
# XAI_API_KEY=xxxxxxxxxxxxxxxxxxxx
# QWEN_API_KEY=xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Default Model Configuration (legacy engine child process)
# =============================================================================

# Default model for all players (format: provider/model)
# Options: openai/gpt-4o-mini, openai/gpt-4o, openai/gpt-4
#         anthropic/claude-3-haiku, anthropic/claude-3-sonnet, anthropic/claude-3-opus
#         google/gemini-1.5-flash, google/gemini-1.5-pro
DEFAULT_MODEL=openai/gpt-4o-mini

# Role-specific model overrides (format: provider/model)
# Leave empty to use DEFAULT_MODEL
MAFIA_MODEL=
DOCTOR_MODEL=
SHERIFF_MODEL=
VIGILANTE_MODEL=
VILLAGER_MODEL=

# =============================================================================
# Local LLM Providers (optional)
# =============================================================================

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama2

# LM Studio (local)
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=meta-llama-llama-2-7b-chat

# =============================================================================
# Game Settings (legacy engine child process)
# =============================================================================

# Persona generation temperature
PERSONA_TEMPERATURE=1.0

# Context management
MAX_CONTEXT_CHARS=100000

# API retry settings
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Multi-role support (experimental)
ALLOW_MULTI_ROLE=false

# =============================================================================
# Server Configuration (apps/server process)
# =============================================================================

# HTTP server port — use PORT=3004 for direct runs on hosts where :3000 is
# taken (e.g. fleet hosts where DuckBrain's HTTP daemon owns :3000). The
# compose stack forces the container-internal port to 3000 via
# docker-compose.yml, so this only affects direct `pnpm run server` runs.
PORT=3004

# Database path
DB_PATH=./data/mafia.db

# Node environment ('production' hides internal error details from API error
# responses). WebSocket traffic rides the same HTTP server — there is no
# separate WS port (the old WS_PORT never had a reader and was removed).
NODE_ENV=development

# =============================================================================
# Development & Debugging
# =============================================================================

# Logging level for the legacy engine's structured logging (pino):
# debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# Model Provider Endpoint (override if needed)
# =============================================================================

# OpenAI-compatible endpoint used by the legacy engine
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Per-provider base URLs (ANTHROPIC_BASE_URL, GOOGLE_BASE_URL, DEEPSEEK_BASE_URL,
# GROQ_BASE_URL, META_BASE_URL, MISTRAL_BASE_URL, XAI_BASE_URL, QWEN_BASE_URL)
# were removed by the MAF-GAP-072 audit: the provider modules pin their own
# endpoints and nothing read those variables.

# =============================================================================
# IMPORTANT: Pricing Information
# =============================================================================
# 
# Model pricing is now fetched DYNAMICALLY from the models.dev API:
# https://models.dev/api.json
#
# NO static prices are configured in this file anymore.
# All pricing comes from the API in real-time.
#
# If a model is not found in the API, its price is set to:
# NO_PRICING_MARKER = -6.66
#
# This ensures accurate, up-to-date pricing for all models.
#
# Popular models and their current API prices:
# - gpt-4o-mini:      $0.15/M in, $0.60/M out
# - gpt-4o:           $2.50/M in, $10.00/M out
# - claude-sonnet-4:  $3.00/M in, $15.00/M out
# - claude-haiku-4:   $1.00/M in, $5.00/M out
# - gemini-2.5-flash: $0.075/M in, $0.30/M out
# - gemini-2.5-pro:   $1.25/M in, $10.00/M out
# - llama-3.3-70b:    $0.59/M in, $0.79/M out
# - deepseek-chat:    $0.28/M in, $0.42/M out
# - grok-3:           $3.00/M in, $15.00/M out
#
# You can check available models and their prices by running:
# node -e "const {getModelPricing} = require('./packages/shared/dist/providers/model-metadata.js'); getModelPricing('gpt-4o-mini').then(console.log);"
#
