{
  "name": "mafia-ai-benchmark",
  "version": "1.1.0",
  "description": "Multi-agent AI Mafia game benchmark system with THINK vs SAYS split-pane consciousness",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "imports": {
    "#game-engine": "./game-engine.cjs",
    "#shared/*": "./packages/shared/src/[pathname].js"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "sh -c '[ \"$1\" = \"--\" ] && shift; exec pnpm --filter @mafia/web dev \"$@\"' dev:web",
    "build": "turbo run build",
    "test": "turbo run test:run",
    "test:counts": "node scripts/sync-test-counts.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "server": "pnpm --filter @mafia/server dev",
    "server:build": "pnpm --filter @mafia/server build",
    "web": "sh -c '[ \"$1\" = \"--\" ] && shift; exec pnpm --filter @mafia/web exec vite \"$@\"' web",
    "web:build": "pnpm --filter @mafia/web build",
    "cli": "pnpm --filter @mafia/cli dev",
    "shared": "pnpm --filter @mafia/shared build",
    "db:migrate": "pnpm --filter @mafia/server db:migrate",
    "game:run": "pnpm --filter @mafia/cli game:run",
    "game:watch": "pnpm --filter @mafia/cli game:watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:wojons/mafia-ai-benchmark.git"
  },
  "keywords": [
    "mafia",
    "social-deduction",
    "multi-agent",
    "ai-benchmark",
    "llm-games"
  ],
  "author": "Mafia AI Benchmark Team",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.15.1"
  },
  "pnpm": {}
}
