# Dependencies — **/ required: bare "node_modules/" only matches the context
# ROOT, not nested workspace dirs (apps/*/node_modules leak into the context
# and COPY clobbers the container's pnpm links — mafia tick 47).
**/node_modules/
**/.pnpm-store/

# Build output (rebuilt in Docker)
**/dist/
# TypeScript incremental build info — copied tsbuildinfo makes tsc skip emit
# (composite projects), leaving no dist in the image (mafia tick 47)
**/*.tsbuildinfo

# Git
.git/
.gitignore
.gitattributes

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Environment (mounted at runtime)
.env
.env.*
!.env.sample

# OS
.DS_Store
Thumbs.db

# Docs & specs
specs/
.memory-bank/
.axiom/
.opencode/
AGENTS.md

# Test & coverage
coverage/
*.test.ts
*.test.tsx
__tests__/
